# environments and builds (machine-specific, -march=native)
.venv*/
build/
*.so
__pycache__/
*.egg-info/
.pytest_cache/

# third-party sources: fetched at pinned commits by scripts/fetch_third_party.sh
third_party/*
!third_party/VAMP_COMMIT
!third_party/vamp_capture_validation.patch
!third_party/dynobench_subset/
!third_party/SOURCES.md
third_party/baseline_prefix/

# copyrighted papers (download from the publishers)
docs/sources/*.pdf

# results: only reports, summaries and manifests are tracked; raw per-attempt data stays local (archived separately)
results/**
!results/**/
!results/README.md
!results/readme_figures_data.json
!results/paper_campaigns/2026-11-25_final_v10*/report*/*
!results/paper_campaigns/2026-11-25_final_v10*/jobs.json
!results/paper_campaigns/2026-11-25_final_v10*/hardware_calibration.json
!results/paper_campaigns/2026-11-25_final_v10*/*/summary.json
!results/paper_campaigns/launch_v10*.sh
!results/paper_campaigns/2026-11-28_final_v2/report*/*
!results/paper_campaigns/2026-11-28_final_v2/jobs.json
!results/paper_campaigns/2026-11-28_final_v2/manifest.json
!results/paper_campaigns/2026-11-28_final_v2/hardware_calibration.json
!results/paper_campaigns/2026-11-28_final_v2/*/summary.json
!results/paper_campaigns/2026-11-28_final_v2.log
!results/paper_campaigns/2026-11-28_final_v2b/report*/*
!results/paper_campaigns/2026-11-28_final_v2b/jobs.json
!results/paper_campaigns/2026-11-28_final_v2b/manifest.json
!results/paper_campaigns/2026-11-28_final_v2b/hardware_calibration.json
!results/paper_campaigns/2026-11-28_final_v2b/*/summary.json
!results/paper_campaigns/2026-11-28_final_v2b.log
!results/diagnostics/v2_chart/*
!results/paper_campaigns/2026-11-28_final_v2d/report*/*
!results/paper_campaigns/2026-11-28_final_v2d/jobs.json
!results/paper_campaigns/2026-11-28_final_v2d/manifest.json
!results/paper_campaigns/2026-11-28_final_v2d/hardware_calibration.json
!results/paper_campaigns/2026-11-28_final_v2d/*/summary.json
!results/paper_campaigns/2026-11-28_final_v2d.log
!results/diagnostics/v2_shortcut/*
!results/diagnostics/v2_shortcut/factorial/*
!results/diagnostics/v2_shortcut/heldout_paired/
!results/diagnostics/v2_shortcut/heldout_paired/*
!results/diagnostics/panda_default_contacts/*
!results/paper_campaigns/2026-11-28_final_v2c/report*/*
!results/paper_campaigns/2026-11-28_final_v2c/jobs.json
!results/paper_campaigns/2026-11-28_final_v2c/manifest.json
!results/paper_campaigns/2026-11-28_final_v2c/hardware_calibration.json
!results/paper_campaigns/2026-11-28_final_v2c/*/summary.json
!results/paper_campaigns/2026-11-28_final_v2c.log
!results/diagnostics/v2_generalization*/RESULT.md
!results/diagnostics/v2_generalization*/summary.json
!results/paper_campaigns/launch_baselines_v10.sh
!results/verification/2026-11-25_acceptance/**/summary.json
!results/verification/2026-11-25_acceptance/v1_math.json
!results/verification/2026-11-25_acceptance/v3_relative.json
!results/verification/2026-11-25_acceptance/v4_long_budget/unsolved_at_60s.json
